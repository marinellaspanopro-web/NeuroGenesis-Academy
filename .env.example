# Clé API Resend (https://resend.com) — nécessaire pour l'envoi réel des
# messages du formulaire de contact. Sans elle, l'API répond 503 et le
# formulaire affiche une erreur invitant à écrire directement par email.
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire (par défaut : info@neurogenesis.academy)
CONTACT_TO_EMAIL=info@neurogenesis.academy

# Adresse d'expédition Resend. Tant qu'aucun domaine n'est vérifié sur Resend,
# utiliser onboarding@resend.dev (limité, pour tests). Une fois le domaine
# neurogenesis.academy vérifié sur Resend, utiliser p.ex. "NeuroGenesis Academy <contact@neurogenesis.academy>".
CONTACT_FROM_EMAIL="NeuroGenesis Academy <onboarding@resend.dev>"
